# Site settings for the Leonardo launchers, configs and scripts (shared by qwen35-posttrain and oellm-rlvr).
# Copy to leonardo.env (git-ignored) or ~/.oellm/leonardo.env, fill in, and `source` it before sbatch; submit from
# $OELLM_WORK/sft-migration-preflight (job logs go to ./logs). Jobs that find OELLM_WORK unset source
# ${OELLM_ENV:-$HOME/.oellm/leonardo.env} themselves.
export OELLM_ACCOUNT=<slurm-account>                              # Slurm project account
export SBATCH_ACCOUNT=$OELLM_ACCOUNT                              # sbatch reads this in place of #SBATCH --account
export OELLM_WORK=/leonardo_work/<ACCOUNT>/<user>                 # your directory on the project's work area
export OELLM_SCRATCH=/leonardo_scratch/large/userexternal/<user>  # usually the same as $SCRATCH
export OELLM_FAST=/leonardo_scratch/fast/<ACCOUNT>/<user>         # fast scratch (staging)
