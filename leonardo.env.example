# Site settings for the Leonardo configs and scripts. Copy to leonardo.env (untracked), fill in, and source it
# before rendering configs or submitting jobs:  cp leonardo.env.example leonardo.env && source leonardo.env
export OELLM_ACCOUNT=<slurm-account>                         # Slurm project account (sbatch --account)
export OELLM_WORK=/leonardo_work/<ACCOUNT>/<user>            # your work area on the project's $WORK
export OELLM_SCRATCH=/leonardo_scratch/large/userexternal/<user>   # usually the same as $SCRATCH
