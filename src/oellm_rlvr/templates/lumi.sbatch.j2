#!/usr/bin/env bash
# Generated by oellm-rlvr. Edit the YAML config, not this file.
#SBATCH --job-name={{ config.name }}
#SBATCH --account={{ config.platform.account }}
#SBATCH --partition={{ config.platform.partition }}
{% if config.platform.qos %}#SBATCH --qos={{ config.platform.qos }}
{% endif %}#SBATCH --nodes={{ config.platform.nodes }}
#SBATCH --gpus-per-node={{ config.platform.gpus_per_node }}
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task={{ config.platform.cpus_per_task }}
{% if config.platform.memory %}#SBATCH --mem={{ config.platform.memory }}
{% endif %}#SBATCH --time={{ config.platform.walltime }}
#SBATCH --output=logs/%j.%x.out
#SBATCH --error=logs/%j.%x.err

set -euo pipefail
module purge
{{ module_lines }}

CONFIG={{ config_path | tojson }}
CONTROL_ROOT={{ control_root | string | tojson }}
BACKEND_ROOT={{ config.backend.repo_path | tojson }}
CONTAINER={{ config.platform.container | tojson }}
BIND={{ bind_value | tojson }}
RAY_PORT={{ config.platform.ray_port }}
GPUS_PER_NODE={{ config.platform.gpus_per_node }}
PYTHON_BIN={{ config.backend.python | tojson }}
RAY_BIN="$(dirname "$PYTHON_BIN")/ray"

mkdir -p logs {{ config.output.directory | tojson }} {{ config.output.rollout_directory | tojson }}
test -r "$CONFIG"
test -r "$CONTAINER"
test -d "$BACKEND_ROOT/.git"

actual_commit="$(git -C "$BACKEND_ROOT" rev-parse HEAD)"
case "$actual_commit" in
  {{ config.backend.commit }}*) ;;
  *) echo "Backend revision mismatch: expected {{ config.backend.commit }}, got $actual_commit" >&2; exit 2 ;;
esac

mapfile -t NODES < <(scontrol show hostnames "$SLURM_JOB_NODELIST")
HEAD_NODE="${NODES[0]}"
HEAD_IP="$(srun --overlap --nodes=1 --ntasks=1 -w "$HEAD_NODE" getent hosts "$HEAD_NODE" | awk 'NR==1 {print $1}')"
RAY_ADDRESS="${HEAD_IP}:${RAY_PORT}"
RAY_TMP="/tmp/oellm-ray-${SLURM_JOB_ID}"

export PYTHONUNBUFFERED=1
export PYTHONPATH="${CONTROL_ROOT}/src:${BACKEND_ROOT}:${PYTHONPATH:-}"
export PATH="$(dirname "$PYTHON_BIN"):$PATH"
export RAY_ADDRESS
export RAY_TMPDIR="$RAY_TMP"
export WANDB_MODE={{ config.output.wandb_mode | tojson }}
export TOKENIZERS_PARALLELISM=false
export VLLM_ALLOW_INSECURE_SERIALIZATION=1
export VLLM_DISABLE_COMPILE_CACHE=1
export VLLM_USE_V1=1
export NCCL_CUMEM_ENABLE=0
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export PYTORCH_HIP_ALLOC_CONF=expandable_segments:True
{% if config.platform.network_interface %}export NCCL_SOCKET_IFNAME={{ config.platform.network_interface | tojson }}
{% endif %}{% for key, value in config.environment.items() %}export {{ key }}={{ value | tojson }}
{% endfor %}

cleanup() {
  if [[ -n "${RAY_STEP_PID:-}" ]]; then kill "$RAY_STEP_PID" 2>/dev/null || true; fi
}
trap cleanup EXIT INT TERM

echo "Preflight: ${SLURM_NNODES} nodes, ${GPUS_PER_NODE} GPUs/node, head=${RAY_ADDRESS}"
srun --label --gpu-bind=none singularity exec {{ accelerator_flag }} -B "$BIND" "$CONTAINER" \
  env PYTHONPATH="$PYTHONPATH" "$PYTHON_BIN" "$CONTROL_ROOT/scripts/preflight_gpu.py" \
  --accelerator {{ config.platform.accelerator }} --gpus "$GPUS_PER_NODE"

srun --label --overlap --gpu-bind=none --nodes="$SLURM_NNODES" --ntasks="$SLURM_NNODES" \
  singularity exec {{ accelerator_flag }} -B "$BIND" "$CONTAINER" \
  env PYTHONPATH="$PYTHONPATH" RAY_TMPDIR="$RAY_TMP" RAY_BIN="$RAY_BIN" \
  bash "$CONTROL_ROOT/scripts/ray_node.sh" "$HEAD_IP" "$RAY_PORT" "$GPUS_PER_NODE" &
RAY_STEP_PID=$!

ready=0
for _ in $(seq 1 60); do
  if srun --overlap --nodes=1 --ntasks=1 -w "$HEAD_NODE" singularity exec {{ accelerator_flag }} -B "$BIND" \
    "$CONTAINER" "$RAY_BIN" status --address="$RAY_ADDRESS" >/dev/null 2>&1; then
    ready=1
    break
  fi
  sleep 2
done
if [[ "$ready" != 1 ]]; then echo "Ray did not become ready" >&2; exit 3; fi

echo "Launching online {{ config.task.kind }} RLVR with native learner-to-vLLM weight transfer"
srun --label --overlap --gpu-bind=none --nodes=1 --ntasks=1 -w "$HEAD_NODE" \
  singularity exec {{ accelerator_flag }} -B "$BIND" "$CONTAINER" \
  env PYTHONPATH="$PYTHONPATH" RAY_ADDRESS="$RAY_ADDRESS" WANDB_MODE="$WANDB_MODE" \
  "$PYTHON_BIN" -m oellm_rlvr.cli run-backend --config "$CONFIG"
